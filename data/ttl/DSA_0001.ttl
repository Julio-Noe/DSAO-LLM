@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0001 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.5" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:fraud_detection ;
  dsao:hasParty :OrgA , :OrgE ;
  dsao:hasGovernancePlan :DSA_0001_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0001_IRP ;
  dsao:hasExitPlan :DSA_0001_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgE a dsao:Party ; dct:title "OrgE" ; dpv:hasRole dpv:Recipient .

:DSA_0001_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:biometric , dsao:usesData dpv:contact .
:DSA_0001_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:biometric .

:DSA_0001_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0001_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "DE" ; dsao:transferMechanism "SCCs" ; dsao:hasSafeguard dpv:encryption_at_rest , dsao:hasSafeguard dpv:access_control .

:DSA_0001_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightAccess ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0001_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0001_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0001 dsao:hasAssessment :DSA_0001_Assess .

:DSA_0001_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "remote_audit" .
:DSA_0001_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0001_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0001_Population a dsao:Population ; dct:title "employees" .
:DSA_0001 dsao:population :DSA_0001_Population .
:DSA_0001_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0001_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .