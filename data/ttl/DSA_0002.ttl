@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0002 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.1" ;
  dpv:hasPurpose dpv:research , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgB , :OrgC ;
  dsao:hasGovernancePlan :DSA_0002_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0002_IRP ;
  dsao:hasExitPlan :DSA_0002_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Processor .

:DSA_0002_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:location , dsao:usesData dpv:biometric .
:DSA_0002_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:contact .

:DSA_0002_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0002_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0002_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0002_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0002 dsao:hasAssessment :DSA_0002_Assess .

:DSA_0002_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "on_site_yearly" .
:DSA_0002_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0002_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0002_Population a dsao:Population ; dct:title "employees" .
:DSA_0002 dsao:population :DSA_0002_Population .