@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0006 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:reporting , dpv:hasPurpose dpv:analytics ;
  dsao:hasParty :OrgB , :OrgD ;
  dsao:hasGovernancePlan :DSA_0006_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0006_IRP ;
  dsao:hasExitPlan :DSA_0006_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:Processor .

:DSA_0006_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:biometric , dsao:usesData dpv:financial .
:DSA_0006_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:financial .

:DSA_0006_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0006_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0006_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0006_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0006 dsao:hasAssessment :DSA_0006_Assess .

:DSA_0006_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "remote_audit" .
:DSA_0006_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0006_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0006_Population a dsao:Population ; dct:title "children" .
:DSA_0006 dsao:population :DSA_0006_Population .
:DSA_0006 dsao:enhancedSafeguard dpv:age_appropriate_design .