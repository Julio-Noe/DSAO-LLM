@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0017 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.1" ;
  dpv:hasPurpose dpv:research , dpv:hasPurpose dpv:reporting ;
  dsao:hasParty :OrgD , :OrgC ;
  dsao:hasGovernancePlan :DSA_0017_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0017_IRP ;
  dsao:hasExitPlan :DSA_0017_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Recipient .

:DSA_0017_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:biometric , dsao:usesData dpv:location .
:DSA_0017_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:contact .

:DSA_0017_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0017_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "JP" ; dsao:transferMechanism "SCCs" ; dsao:hasSafeguard dpv:encryption_at_rest , dsao:hasSafeguard dpv:access_control .

:DSA_0017_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgD ; dsao:procedureURL <https> .

:DSA_0017_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgD ; foaf:page <https> .

:DSA_0017_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0017 dsao:hasAssessment :DSA_0017_Assess .

:DSA_0017_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "third_party_audit" .
:DSA_0017_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0017_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0017_Population a dsao:Population ; dct:title "children" .
:DSA_0017 dsao:population :DSA_0017_Population .
:DSA_0017 dsao:enhancedSafeguard dpv:age_appropriate_design .
:DSA_0017_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0017_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .