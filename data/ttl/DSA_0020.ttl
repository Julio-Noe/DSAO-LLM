@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0020 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.2" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:fraud_detection ;
  dsao:hasParty :OrgA , :OrgB ;
  dsao:hasGovernancePlan :DSA_0020_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0020_IRP ;
  dsao:hasExitPlan :DSA_0020_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:Recipient .

:DSA_0020_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:contact , dsao:usesData dpv:financial .
:DSA_0020_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:health .

:DSA_0020_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0020_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0020_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0020_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "third_party_audit" .
:DSA_0020_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0020_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0020_Population a dsao:Population ; dct:title "general" .
:DSA_0020 dsao:population :DSA_0020_Population .
:DSA_0020_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0020_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .