@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0023 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:service_provision , dpv:hasPurpose dpv:research ;
  dsao:hasParty :OrgE , :OrgA ;
  dsao:hasGovernancePlan :DSA_0023_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0023_IRP ;
  dsao:hasExitPlan :DSA_0023_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgE a dsao:Party ; dct:title "OrgE" ; dpv:hasRole dpv:DataController .
:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:Recipient .

:DSA_0023_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:health , dsao:usesData dpv:biometric .
:DSA_0023_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:biometric .

:DSA_0023_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0023_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgE ; dsao:procedureURL <https> .

:DSA_0023_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgE ; foaf:page <https> .

:DSA_0023_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0023 dsao:hasAssessment :DSA_0023_Assess .

:DSA_0023_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "remote_audit" .
:DSA_0023_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0023_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0023_Population a dsao:Population ; dct:title "general" .
:DSA_0023 dsao:population :DSA_0023_Population .