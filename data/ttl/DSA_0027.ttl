@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0027 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.2" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:reporting ;
  dsao:hasParty :OrgD , :OrgB ;
  dsao:hasGovernancePlan :DSA_0027_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0027_IRP ;
  dsao:hasExitPlan :DSA_0027_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:DataController .
:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:Recipient .

:DSA_0027_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:health , dsao:usesData dpv:location .
:DSA_0027_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:location .

:DSA_0027_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0027_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "SG" ; dsao:transferMechanism "SCCs" ; dsao:hasSafeguard dpv:pseudonymisation , dsao:hasSafeguard dpv:access_control .

:DSA_0027_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgD ; dsao:procedureURL <https> .

:DSA_0027_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgD ; foaf:page <https> .

:DSA_0027_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0027 dsao:hasAssessment :DSA_0027_Assess .

:DSA_0027_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "remote_audit" .
:DSA_0027_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0027_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0027_Population a dsao:Population ; dct:title "children" .
:DSA_0027 dsao:population :DSA_0027_Population .
:DSA_0027 dsao:enhancedSafeguard dpv:age_appropriate_design .