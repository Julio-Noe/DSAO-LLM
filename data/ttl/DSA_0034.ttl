@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0034 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.2" ;
  dpv:hasPurpose dpv:research , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgB , :OrgD ;
  dsao:hasGovernancePlan :DSA_0034_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0034_IRP ;
  dsao:hasExitPlan :DSA_0034_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:Recipient .

:DSA_0034_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:location , dsao:usesData dpv:biometric .
:DSA_0034_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:contact .

:DSA_0034_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0034_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0034_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0034_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0034 dsao:hasAssessment :DSA_0034_Assess .

:DSA_0034_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "on_site_yearly" .
:DSA_0034_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0034_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0034_Population a dsao:Population ; dct:title "general" .
:DSA_0034 dsao:population :DSA_0034_Population .