@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0036 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.0" ;
  dpv:hasPurpose dpv:service_provision , dpv:hasPurpose dpv:reporting ;
  dsao:hasParty :OrgD , :OrgA ;
  dsao:hasGovernancePlan :DSA_0036_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0036_IRP ;
  dsao:hasExitPlan :DSA_0036_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:DataController .
:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:Processor .

:DSA_0036_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:health , dsao:usesData dpv:biometric .
:DSA_0036_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:financial .

:DSA_0036_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0036_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "DE" ; dsao:transferMechanism "BCRs" ; dsao:hasSafeguard dpv:key_separation , dsao:hasSafeguard dpv:encryption_at_rest .

:DSA_0036_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgD ; dsao:procedureURL <https> .

:DSA_0036_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgD ; foaf:page <https> .

:DSA_0036_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0036 dsao:hasAssessment :DSA_0036_Assess .

:DSA_0036_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "remote_audit" .
:DSA_0036_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0036_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0036_Population a dsao:Population ; dct:title "children" .
:DSA_0036 dsao:population :DSA_0036_Population .
:DSA_0036 dsao:enhancedSafeguard dpv:age_appropriate_design .