@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0039 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.0" ;
  dpv:hasPurpose dpv:reporting , dpv:hasPurpose dpv:research ;
  dsao:hasParty :OrgA , :OrgD ;
  dsao:hasGovernancePlan :DSA_0039_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0039_IRP ;
  dsao:hasExitPlan :DSA_0039_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:Processor .

:DSA_0039_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:contact , dsao:usesData dpv:location .
:DSA_0039_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:location .

:DSA_0039_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0039_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "ZA" ; dsao:transferMechanism "BCRs" ; dsao:hasSafeguard dpv:key_separation , dsao:hasSafeguard dpv:encryption_at_rest .

:DSA_0039_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightAccess ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0039_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0039_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0039 dsao:hasAssessment :DSA_0039_Assess .

:DSA_0039_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "third_party_audit" .
:DSA_0039_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0039_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0039_Population a dsao:Population ; dct:title "general" .
:DSA_0039 dsao:population :DSA_0039_Population .
:DSA_0039_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0039_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .