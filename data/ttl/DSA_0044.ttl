@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0044 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:research ;
  dsao:hasParty :OrgC , :OrgD ;
  dsao:hasGovernancePlan :DSA_0044_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0044_IRP ;
  dsao:hasExitPlan :DSA_0044_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:DataController .
:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:Processor .

:DSA_0044_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:health , dsao:usesData dpv:contact .
:DSA_0044_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:contact .

:DSA_0044_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0044_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "SG" ; dsao:transferMechanism "Adequacy" ; dsao:hasSafeguard dpv:pseudonymisation , dsao:hasSafeguard dpv:access_control .

:DSA_0044_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgC ; dsao:procedureURL <https> .

:DSA_0044_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgC ; foaf:page <https> .

:DSA_0044_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0044 dsao:hasAssessment :DSA_0044_Assess .

:DSA_0044_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "third_party_audit" .
:DSA_0044_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0044_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0044_Population a dsao:Population ; dct:title "children" .
:DSA_0044 dsao:population :DSA_0044_Population .
:DSA_0044 dsao:enhancedSafeguard dpv:age_appropriate_design .
:DSA_0044_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0044_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .