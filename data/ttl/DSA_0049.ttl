@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0049 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.2" ;
  dpv:hasPurpose dpv:research , dpv:hasPurpose dpv:fraud_detection ;
  dsao:hasParty :OrgB , :OrgD ;
  dsao:hasGovernancePlan :DSA_0049_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0049_IRP ;
  dsao:hasExitPlan :DSA_0049_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:Processor .

:DSA_0049_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:contact , dsao:usesData dpv:location .
:DSA_0049_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:financial .

:DSA_0049_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0049_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0049_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0049_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "on_site_yearly" .
:DSA_0049_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0049_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0049_Population a dsao:Population ; dct:title "employees" .
:DSA_0049 dsao:population :DSA_0049_Population .