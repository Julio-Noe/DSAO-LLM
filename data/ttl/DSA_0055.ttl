@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0055 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.4" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:fraud_detection ;
  dsao:hasParty :OrgB , :OrgC ;
  dsao:hasGovernancePlan :DSA_0055_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0055_IRP ;
  dsao:hasExitPlan :DSA_0055_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Recipient .

:DSA_0055_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:location , dsao:usesData dpv:financial .
:DSA_0055_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:financial .

:DSA_0055_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0055_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0055_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0055_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "remote_audit" .
:DSA_0055_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0055_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0055_Population a dsao:Population ; dct:title "employees" .
:DSA_0055 dsao:population :DSA_0055_Population .