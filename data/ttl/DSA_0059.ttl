@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0059 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:fraud_detection , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgB , :OrgA ;
  dsao:hasGovernancePlan :DSA_0059_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0059_IRP ;
  dsao:hasExitPlan :DSA_0059_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:Recipient .

:DSA_0059_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:biometric , dsao:usesData dpv:contact .
:DSA_0059_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:health .

:DSA_0059_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0059_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "JP" ; dsao:transferMechanism "SCCs" ; dsao:hasSafeguard dpv:key_separation , dsao:hasSafeguard dpv:pseudonymisation .

:DSA_0059_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0059_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0059_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0059 dsao:hasAssessment :DSA_0059_Assess .

:DSA_0059_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "remote_audit" .
:DSA_0059_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0059_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0059_Population a dsao:Population ; dct:title "employees" .
:DSA_0059 dsao:population :DSA_0059_Population .