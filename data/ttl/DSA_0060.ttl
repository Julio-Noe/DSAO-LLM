@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0060 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.4" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:fraud_detection ;
  dsao:hasParty :OrgB , :OrgD ;
  dsao:hasGovernancePlan :DSA_0060_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0060_IRP ;
  dsao:hasExitPlan :DSA_0060_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:Processor .

:DSA_0060_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:contact , dsao:usesData dpv:health .
:DSA_0060_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:location .

:DSA_0060_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0060_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "SG" ; dsao:transferMechanism "BCRs" ; dsao:hasSafeguard dpv:access_control , dsao:hasSafeguard dpv:pseudonymisation .

:DSA_0060_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0060_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0060_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0060 dsao:hasAssessment :DSA_0060_Assess .

:DSA_0060_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "remote_audit" .
:DSA_0060_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0060_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0060_Population a dsao:Population ; dct:title "general" .
:DSA_0060 dsao:population :DSA_0060_Population .