@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0061 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:reporting , dpv:hasPurpose dpv:research ;
  dsao:hasParty :OrgB , :OrgE ;
  dsao:hasGovernancePlan :DSA_0061_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0061_IRP ;
  dsao:hasExitPlan :DSA_0061_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgE a dsao:Party ; dct:title "OrgE" ; dpv:hasRole dpv:Processor .

:DSA_0061_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:biometric , dsao:usesData dpv:contact .
:DSA_0061_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:biometric .

:DSA_0061_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0061_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "BR" ; dsao:transferMechanism "Adequacy" ; dsao:hasSafeguard dpv:pseudonymisation , dsao:hasSafeguard dpv:access_control .

:DSA_0061_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightAccess ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0061_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0061_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0061 dsao:hasAssessment :DSA_0061_Assess .

:DSA_0061_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "on_site_yearly" .
:DSA_0061_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0061_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0061_Population a dsao:Population ; dct:title "general" .
:DSA_0061 dsao:population :DSA_0061_Population .
:DSA_0061_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0061_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .