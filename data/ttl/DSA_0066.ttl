@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0066 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.0" ;
  dpv:hasPurpose dpv:reporting , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgC , :OrgE ;
  dsao:hasGovernancePlan :DSA_0066_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0066_IRP ;
  dsao:hasExitPlan :DSA_0066_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:DataController .
:OrgE a dsao:Party ; dct:title "OrgE" ; dpv:hasRole dpv:Processor .

:DSA_0066_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:health , dsao:usesData dpv:location .
:DSA_0066_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:financial .

:DSA_0066_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0066_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgC ; dsao:procedureURL <https> .

:DSA_0066_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgC ; foaf:page <https> .

:DSA_0066_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0066 dsao:hasAssessment :DSA_0066_Assess .

:DSA_0066_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "remote_audit" .
:DSA_0066_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0066_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0066_Population a dsao:Population ; dct:title "general" .
:DSA_0066 dsao:population :DSA_0066_Population .
:DSA_0066_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0066_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .