@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0067 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.5" ;
  dpv:hasPurpose dpv:fraud_detection , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgC , :OrgE ;
  dsao:hasGovernancePlan :DSA_0067_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0067_IRP ;
  dsao:hasExitPlan :DSA_0067_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:DataController .
:OrgE a dsao:Party ; dct:title "OrgE" ; dpv:hasRole dpv:Recipient .

:DSA_0067_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:location , dsao:usesData dpv:health .
:DSA_0067_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:contact .

:DSA_0067_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0067_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgC ; dsao:procedureURL <https> .

:DSA_0067_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgC ; foaf:page <https> .

:DSA_0067_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0067 dsao:hasAssessment :DSA_0067_Assess .

:DSA_0067_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "third_party_audit" .
:DSA_0067_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0067_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0067_Population a dsao:Population ; dct:title "children" .
:DSA_0067 dsao:population :DSA_0067_Population .
:DSA_0067 dsao:enhancedSafeguard dpv:age_appropriate_design .