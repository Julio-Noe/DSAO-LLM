@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0068 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:reporting ;
  dsao:hasParty :OrgA , :OrgB ;
  dsao:hasGovernancePlan :DSA_0068_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0068_IRP ;
  dsao:hasExitPlan :DSA_0068_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:Processor .

:DSA_0068_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:biometric , dsao:usesData dpv:contact .
:DSA_0068_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:biometric .

:DSA_0068_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0068_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0068_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0068_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0068 dsao:hasAssessment :DSA_0068_Assess .

:DSA_0068_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "remote_audit" .
:DSA_0068_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0068_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0068_Population a dsao:Population ; dct:title "employees" .
:DSA_0068 dsao:population :DSA_0068_Population .
:DSA_0068_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0068_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .