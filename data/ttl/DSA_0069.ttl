@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0069 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.0" ;
  dpv:hasPurpose dpv:fraud_detection , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgA , :OrgB ;
  dsao:hasGovernancePlan :DSA_0069_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0069_IRP ;
  dsao:hasExitPlan :DSA_0069_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:Recipient .

:DSA_0069_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:location , dsao:usesData dpv:health .
:DSA_0069_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:financial .

:DSA_0069_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0069_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0069_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0069_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0069 dsao:hasAssessment :DSA_0069_Assess .

:DSA_0069_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "on_site_yearly" .
:DSA_0069_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0069_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0069_Population a dsao:Population ; dct:title "employees" .
:DSA_0069 dsao:population :DSA_0069_Population .