@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0070 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.5" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:fraud_detection ;
  dsao:hasParty :OrgA , :OrgC ;
  dsao:hasGovernancePlan :DSA_0070_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0070_IRP ;
  dsao:hasExitPlan :DSA_0070_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Recipient .

:DSA_0070_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:contact , dsao:usesData dpv:financial .
:DSA_0070_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:financial .

:DSA_0070_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "Return" .

:DSA_0070_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "AU" ; dsao:transferMechanism "Adequacy" ; dsao:hasSafeguard dpv:key_separation , dsao:hasSafeguard dpv:access_control .

:DSA_0070_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightAccess ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0070_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "direct" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0070_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0070 dsao:hasAssessment :DSA_0070_Assess .

:DSA_0070_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "remote_audit" .
:DSA_0070_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0070_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0070_Population a dsao:Population ; dct:title "children" .
:DSA_0070 dsao:population :DSA_0070_Population .
:DSA_0070 dsao:enhancedSafeguard dpv:age_appropriate_design .