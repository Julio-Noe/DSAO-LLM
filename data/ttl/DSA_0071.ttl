@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0071 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:fraud_detection , dpv:hasPurpose dpv:analytics ;
  dsao:hasParty :OrgD , :OrgC ;
  dsao:hasGovernancePlan :DSA_0071_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0071_IRP ;
  dsao:hasExitPlan :DSA_0071_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Processor .

:DSA_0071_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:biometric , dsao:usesData dpv:contact .
:DSA_0071_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:contact .

:DSA_0071_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0071_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightAccess ; dsao:responsibleParty :OrgD ; dsao:procedureURL <https> .

:DSA_0071_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgD ; foaf:page <https> .

:DSA_0071_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0071 dsao:hasAssessment :DSA_0071_Assess .

:DSA_0071_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "remote_audit" .
:DSA_0071_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0071_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0071_Population a dsao:Population ; dct:title "children" .
:DSA_0071 dsao:population :DSA_0071_Population .
:DSA_0071 dsao:enhancedSafeguard dpv:age_appropriate_design .
:DSA_0071_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0071_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .