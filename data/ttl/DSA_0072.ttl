@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0072 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.4" ;
  dpv:hasPurpose dpv:analytics , dpv:hasPurpose dpv:reporting ;
  dsao:hasParty :OrgA , :OrgB ;
  dsao:hasGovernancePlan :DSA_0072_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0072_IRP ;
  dsao:hasExitPlan :DSA_0072_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:Processor .

:DSA_0072_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:contact , dsao:usesData dpv:biometric .
:DSA_0072_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:biometric .

:DSA_0072_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0072_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "ZA" ; dsao:transferMechanism "BCRs" ; dsao:hasSafeguard dpv:encryption_at_rest , dsao:hasSafeguard dpv:key_separation .

:DSA_0072_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0072_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0072_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0072 dsao:hasAssessment :DSA_0072_Assess .

:DSA_0072_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "on_site_yearly" .
:DSA_0072_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0072_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0072_Population a dsao:Population ; dct:title "general" .
:DSA_0072 dsao:population :DSA_0072_Population .