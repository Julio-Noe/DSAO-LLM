@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0073 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.1" ;
  dpv:hasPurpose dpv:service_provision , dpv:hasPurpose dpv:analytics ;
  dsao:hasParty :OrgD , :OrgE ;
  dsao:hasGovernancePlan :DSA_0073_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0073_IRP ;
  dsao:hasExitPlan :DSA_0073_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:DataController .
:OrgE a dsao:Party ; dct:title "OrgE" ; dpv:hasRole dpv:Recipient .

:DSA_0073_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:location , dsao:usesData dpv:biometric .
:DSA_0073_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:location .

:DSA_0073_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0073_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgD ; dsao:procedureURL <https> .

:DSA_0073_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgD ; foaf:page <https> .

:DSA_0073_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "medium" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0073 dsao:hasAssessment :DSA_0073_Assess .

:DSA_0073_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "on_site_yearly" .
:DSA_0073_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0073_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0073_Population a dsao:Population ; dct:title "children" .
:DSA_0073 dsao:population :DSA_0073_Population .
:DSA_0073 dsao:enhancedSafeguard dpv:age_appropriate_design .
:DSA_0073_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0073_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .