@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0077 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.2" ;
  dpv:hasPurpose dpv:fraud_detection , dpv:hasPurpose dpv:reporting ;
  dsao:hasParty :OrgE , :OrgC ;
  dsao:hasGovernancePlan :DSA_0077_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0077_IRP ;
  dsao:hasExitPlan :DSA_0077_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgE a dsao:Party ; dct:title "OrgE" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Recipient .

:DSA_0077_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:location , dsao:usesData dpv:biometric .
:DSA_0077_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:reporting ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:contact .

:DSA_0077_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0077_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgE ; dsao:procedureURL <https> .

:DSA_0077_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgE ; foaf:page <https> .

:DSA_0077_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0077 dsao:hasAssessment :DSA_0077_Assess .

:DSA_0077_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "third_party_audit" .
:DSA_0077_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0077_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0077_Population a dsao:Population ; dct:title "employees" .
:DSA_0077 dsao:population :DSA_0077_Population .
:DSA_0077_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0077_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .