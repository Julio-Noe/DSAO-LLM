@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0087 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.5" ;
  dpv:hasPurpose dpv:service_provision , dpv:hasPurpose dpv:fraud_detection ;
  dsao:hasParty :OrgD , :OrgC ;
  dsao:hasGovernancePlan :DSA_0087_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0087_IRP ;
  dsao:hasExitPlan :DSA_0087_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgD a dsao:Party ; dct:title "OrgD" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Recipient .

:DSA_0087_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:biometric , dsao:usesData dpv:financial .
:DSA_0087_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:location .

:DSA_0087_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0087_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgD ; dsao:procedureURL <https> .

:DSA_0087_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgD ; foaf:page <https> .

:DSA_0087_Assess a dsao:Assessment ; dsao:assessmentType "DPIA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0087 dsao:hasAssessment :DSA_0087_Assess .

:DSA_0087_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P6M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "on_site_yearly" .
:DSA_0087_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0087_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0087_Population a dsao:Population ; dct:title "employees" .
:DSA_0087 dsao:population :DSA_0087_Population .