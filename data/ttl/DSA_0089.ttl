@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0089 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.0" ;
  dpv:hasPurpose dpv:service_provision , dpv:hasPurpose dpv:analytics ;
  dsao:hasParty :OrgB , :OrgA ;
  dsao:hasGovernancePlan :DSA_0089_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0089_IRP ;
  dsao:hasExitPlan :DSA_0089_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:Recipient .

:DSA_0089_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:financial , dsao:usesData dpv:location .
:DSA_0089_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:financial .

:DSA_0089_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0089_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0089_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0089_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "remote_audit" .
:DSA_0089_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0089_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0089_Population a dsao:Population ; dct:title "general" .
:DSA_0089 dsao:population :DSA_0089_Population .
:DSA_0089_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0089_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .