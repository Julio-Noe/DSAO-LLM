@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0093 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.1" ;
  dpv:hasPurpose dpv:fraud_detection , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgB , :OrgA ;
  dsao:hasGovernancePlan :DSA_0093_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0093_IRP ;
  dsao:hasExitPlan :DSA_0093_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:DataController .
:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:Recipient .

:DSA_0093_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:fraud_detection ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:financial , dsao:usesData dpv:location .
:DSA_0093_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:financial .

:DSA_0093_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P12M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0093_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightErasure ; dsao:responsibleParty :OrgB ; dsao:procedureURL <https> .

:DSA_0093_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "layered" ; dsao:issuer :OrgB ; foaf:page <https> .

:DSA_0093_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "AuditFindings<=2" ; dsao:auditRight "remote_audit" .
:DSA_0093_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0093_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0093_Population a dsao:Population ; dct:title "children" .
:DSA_0093 dsao:population :DSA_0093_Population .
:DSA_0093 dsao:enhancedSafeguard dpv:age_appropriate_design .