@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0096 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.1" ;
  dpv:hasPurpose dpv:research , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgC , :OrgA ;
  dsao:hasGovernancePlan :DSA_0096_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0096_IRP ;
  dsao:hasExitPlan :DSA_0096_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:DataController .
:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:Processor .

:DSA_0096_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:biometric , dsao:usesData dpv:health .
:DSA_0096_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:legitimate_interest ; dsao:usesData dpv:contact .

:DSA_0096_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P18M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0096_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightAccess ; dsao:responsibleParty :OrgC ; dsao:procedureURL <https> .

:DSA_0096_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgC ; foaf:page <https> .

:DSA_0096_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "high" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0096 dsao:hasAssessment :DSA_0096_Assess .

:DSA_0096_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "on_site_yearly" .
:DSA_0096_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0096_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0096_Population a dsao:Population ; dct:title "children" .
:DSA_0096 dsao:population :DSA_0096_Population .
:DSA_0096 dsao:enhancedSafeguard dpv:age_appropriate_design .