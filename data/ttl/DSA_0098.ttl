@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0098 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.5" ;
  dpv:hasPurpose dpv:research , dpv:hasPurpose dpv:service_provision ;
  dsao:hasParty :OrgA , :OrgC ;
  dsao:hasGovernancePlan :DSA_0098_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0098_IRP ;
  dsao:hasExitPlan :DSA_0098_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgC a dsao:Party ; dct:title "OrgC" ; dpv:hasRole dpv:Processor .

:DSA_0098_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:research ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:location , dsao:usesData dpv:health .
:DSA_0098_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:public_interest ; dsao:usesData dpv:location .

:DSA_0098_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "Anonymise" .

:DSA_0098_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "SG" ; dsao:transferMechanism "Adequacy" ; dsao:hasSafeguard dpv:key_separation , dsao:hasSafeguard dpv:pseudonymisation .

:DSA_0098_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightRectification ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0098_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0098_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0098 dsao:hasAssessment :DSA_0098_Assess .

:DSA_0098_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "DSAR_SLA_<=30d" ; dsao:auditRight "third_party_audit" .
:DSA_0098_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0098_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "Return" ; dsao:postTerminationObligation "no_redisclosure" .
:DSA_0098_Population a dsao:Population ; dct:title "employees" .
:DSA_0098 dsao:population :DSA_0098_Population .
:DSA_0098_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0098_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .