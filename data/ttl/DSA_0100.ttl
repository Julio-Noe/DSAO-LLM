@prefix :      <https://example.org/dsao/inst/> .
@prefix dsao:  <https://w3id.org/dsao#> .
@prefix dpv:   <https://w3id.org/dpv#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

:DSA_0100 a dsao:DataSharingAgreement ;
  dct:hasVersion "1.0.3" ;
  dpv:hasPurpose dpv:service_provision , dpv:hasPurpose dpv:analytics ;
  dsao:hasParty :OrgA , :OrgB ;
  dsao:hasGovernancePlan :DSA_0100_Gov ;
  dsao:hasIncidentResponsePlan :DSA_0100_IRP ;
  dsao:hasExitPlan :DSA_0100_Exit ;
  dct:created "2025-11-14T21:22:59Z"^^xsd:dateTime .

:OrgA a dsao:Party ; dct:title "OrgA" ; dpv:hasRole dpv:DataController .
:OrgB a dsao:Party ; dct:title "OrgB" ; dpv:hasRole dpv:Processor .

:DSA_0100_P1 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:service_provision ; dpv:hasLegalBasis dpv:contract ; dsao:usesData dpv:location , dsao:usesData dpv:biometric .
:DSA_0100_P2 a dsao:ProcessingActivity ; dpv:hasPurpose dpv:analytics ; dpv:hasLegalBasis dpv:legal_obligation ; dsao:usesData dpv:health .

:DSA_0100_DS1 a dsao:SharedDataset , dcat:Dataset ;
  dct:conformsTo <https> ;
  dpv:hasStorage [ a dpv:Storage ; dpv:hasDuration "P6M"^^xsd:duration ] ;
  dsao:disposalMethod "SecureDelete" .

:DSA_0100_T1 a dsao:InternationalTransfer ; dsao:destinationCountry "JP" ; dsao:transferMechanism "Adequacy" ; dsao:hasSafeguard dpv:access_control , dsao:hasSafeguard dpv:key_separation .

:DSA_0100_RH1 a dsao:RightsHandling ; dsao:forRight dpv:RightAccess ; dsao:responsibleParty :OrgA ; dsao:procedureURL <https> .

:DSA_0100_TA1 a dsao:TransparencyArrangement ; dsao:noticeType "indirect" ; dsao:issuer :OrgA ; foaf:page <https> .

:DSA_0100_Assess a dsao:Assessment ; dsao:assessmentType "TRA" ; dsao:assessmentOutcome "low" ; dct:references <https://example.org/dpia.pdf> .
:DSA_0100 dsao:hasAssessment :DSA_0100_Assess .

:DSA_0100_Gov a dsao:GovernancePlan ; dsao:reviewFrequency "P12M" ; dsao:metric "BreachMTTR<=72h" ; dsao:auditRight "third_party_audit" .
:DSA_0100_IRP a dsao:IncidentResponsePlan ; dsao:notificationDeadline "PT72H"^^xsd:duration ; dsao:contactPoint "mailto:sec@example.org" .
:DSA_0100_Exit a dsao:ExitPlan ; dsao:exitTrigger "contract_end" ; dsao:dataDisposition "SecureDelete" ; dsao:postTerminationObligation "no_contact_after_exit" .
:DSA_0100_Population a dsao:Population ; dct:title "children" .
:DSA_0100 dsao:population :DSA_0100_Population .
:DSA_0100 dsao:enhancedSafeguard dpv:age_appropriate_design .
:DSA_0100_RN1 a dsao:ReviewNote ; dsao:justifies :DSA_0100_P1 ; dsao:guidelineRef "ICO-2021-§3.2" ; dsao:decision "needs-change" ; dsao:rating 2 ; dct:description "reduce data categories" .